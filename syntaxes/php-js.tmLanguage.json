{
  "scopeName": "source.php.js",
  "injectionSelector": "L:text.html.php -comment -string",
  "patterns": [
    {
      "include": "#js-string-double-quoted"
    },
    {
      "include": "#js-string-single-quoted"
    },
    {
      "include": "#js-heredoc"
    },
    {
      "include": "#js-nowdoc"
    }
  ],
  "repository": {
    "js-nowdoc": {
      "begin": "(/\\*\\s?js\\s?\\*/)\\s*(<<<)(')([A-Za-z_][A-Za-z_0-9]*)\\3(?:\\r?\\n)",
      "beginCaptures": {
        "1": {
          "name": "comment.block.php"
        },
        "2": {
          "name": "punctuation.definition.string.begin.php"
        },
        "3": {
          "name": "punctuation.definition.string.begin.php"
        },
        "4": {
          "name": "keyword.operator.nowdoc.php"
        }
      },
      "end": "^(\\4)(;?)",
      "endCaptures": {
        "1": {
          "name": "keyword.operator.nowdoc.php"
        },
        "2": {
          "name": "punctuation.terminator.expression.php"
        }
      },
      "name": "string.unquoted.nowdoc.php",
      "contentName": "meta.embedded.block.javascript.php source.js.embedded.php",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "js-heredoc": {
      "begin": "(/\\*\\s?js\\s?\\*/)\\s*(<<<)(\"?)([A-Za-z_][A-Za-z_0-9]*)\\3(?:\\r?\\n)",
      "beginCaptures": {
        "1": {
          "name": "comment.block.php"
        },
        "2": {
          "name": "punctuation.definition.string.begin.php"
        },
        "3": {
          "name": "punctuation.definition.string.begin.php"
        },
        "4": {
          "name": "keyword.operator.heredoc.php"
        }
      },
      "end": "^(\\4)(;?)",
      "endCaptures": {
        "1": {
          "name": "keyword.operator.heredoc.php"
        },
        "2": {
          "name": "punctuation.terminator.expression.php"
        }
      },
      "name": "string.unquoted.heredoc.php",
      "contentName": "meta.embedded.block.javascript.php source.js.embedded.php",
      "patterns": [
        {
          "include": "source.php#interpolation_double_quoted"
        },
        {
          "include": "source.js"
        }
      ]
    },
    "js-string-double-quoted": {
      "begin": "(/\\*\\s?js\\s?\\*/)\\s*(\")",
      "beginCaptures": {
        "1": {
          "name": "comment.block.php"
        },
        "2": {
          "name": "punctuation.definition.string.begin.php"
        }
      },
      "end": "(\")",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.php"
        }
      },
      "name": "string.quoted.double.php",
      "patterns": [
        {
          "begin": "(?<=\")",
          "contentName": "source.js.embedded.php",
          "end": "(?=\")",
          "name": "string.quoted.double.js.php",
          "patterns": [
            {
              "begin": "\\s*(?=<script)",
              "end": "(?=\")",
              "patterns": [
                {
                  "include": "source.php#interpolation_double_quoted"
                },
                {
                  "include": "text.html.basic"
                }
              ]
            },
            {
              "include": "source.php#interpolation_double_quoted"
            },
            {
              "include": "source.js"
            }
          ]
        }
      ]
    },
    "js-string-single-quoted": {
      "begin": "(/\\*\\s?js\\s?\\*/)\\s*(')",
      "beginCaptures": {
        "1": {
          "name": "comment.block.php"
        },
        "2": {
          "name": "punctuation.definition.string.begin.php"
        }
      },
      "end": "(')",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.php"
        }
      },
      "name": "string.quoted.single.php",
      "patterns": [
        {
          "begin": "(?<=')",
          "contentName": "source.js.embedded.php",
          "end": "(?=')",
          "name": "string.quoted.single.js.php",
          "patterns": [
            {
              "begin": "\\s*(?=<script)",
              "end": "(?=')",
              "patterns": [
                {
                  "include": "text.html.basic"
                }
              ]
            },
            {
              "include": "source.js"
            }
          ]
        }
      ]
    }
  }
}
