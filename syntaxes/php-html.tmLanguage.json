{
  "scopeName": "source.php.html",
  "injectionSelector": "L:text.html.php -comment -string",
  "patterns": [
    {
      "include": "#html-string-double-quoted"
    },
    {
      "include": "#html-string-single-quoted"
    },
    {
      "include": "#html-heredoc"
    },
    {
      "include": "#html-nowdoc"
    }
  ],
  "repository": {
    "html-nowdoc": {
      "begin": "(/\\*\\s?html\\s?\\*/)\\s*(<<<)(')([A-Za-z_][A-Za-z_0-9]*)\\3(?:\\r?\\n)",
      "beginCaptures": {
        "1": {
          "name": "comment.block.php"
        },
        "2": {
          "name": "punctuation.definition.string.begin.php"
        },
        "3": {
          "name": "punctuation.definition.string.begin.php"
        },
        "4": {
          "name": "keyword.operator.nowdoc.php"
        }
      },
      "end": "^(\\4)(;?)",
      "endCaptures": {
        "1": {
          "name": "keyword.operator.nowdoc.php"
        },
        "2": {
          "name": "punctuation.terminator.expression.php"
        }
      },
      "name": "string.unquoted.nowdoc.php",
      "contentName": "meta.embedded.block.html.php text.html.embedded.php",
      "patterns": [
        {
          "include": "text.html.basic"
        }
      ]
    },
    "html-heredoc": {
      "begin": "(/\\*\\s?html\\s?\\*/)\\s*(<<<)(\"?)([A-Za-z_][A-Za-z_0-9]*)\\3(?:\\r?\\n)",
      "beginCaptures": {
        "1": {
          "name": "comment.block.php"
        },
        "2": {
          "name": "punctuation.definition.string.begin.php"
        },
        "3": {
          "name": "punctuation.definition.string.begin.php"
        },
        "4": {
          "name": "keyword.operator.heredoc.php"
        }
      },
      "end": "^(\\4)(;?)",
      "endCaptures": {
        "1": {
          "name": "keyword.operator.heredoc.php"
        },
        "2": {
          "name": "punctuation.terminator.expression.php"
        }
      },
      "name": "string.unquoted.heredoc.php",
      "contentName": "meta.embedded.block.html.php text.html.embedded.php",
      "patterns": [
        {
          "include": "source.php#interpolation_double_quoted"
        },
        {
          "include": "text.html.basic"
        }
      ]
    },
    "html-string-double-quoted": {
      "begin": "(/\\*\\s?html\\s?\\*/)\\s*(\")",
      "beginCaptures": {
        "1": {
          "name": "comment.block.php"
        },
        "2": {
          "name": "punctuation.definition.string.begin.php"
        }
      },
      "end": "(\")",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.php"
        }
      },
      "name": "string.quoted.double.php",
      "patterns": [
        {
          "begin": "(?<=\")",
          "contentName": "text.html.embedded.php",
          "end": "(?=\")",
          "name": "string.quoted.double.html.php",
          "patterns": [
            {
              "begin": "(<)([a-zA-Z][a-zA-Z0-9]*)",
              "end": "(?=(>|\\/>)|(?=\"))",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.tag.begin.html"
                },
                "2": {
                  "name": "entity.name.tag.html"
                }
              },
              "endCaptures": {
                "1": {
                  "name": "punctuation.definition.tag.end.html"
                }
              },
              "patterns": [
                {
                  "begin": "\\s*([a-zA-Z0-9:-]+)\\s*(=)\\s*",
                  "beginCaptures": {
                    "1": {
                      "name": "entity.other.attribute-name.html"
                    },
                    "2": {
                      "name": "punctuation.separator.key-value.html"
                    }
                  },
                  "end": "(?<=\")|(?<=')|(?=[\\s/>]|\")",
                  "patterns": [
                    {
                      "begin": "\"",
                      "end": "\"",
                      "name": "string.quoted.double.html",
                      "patterns": [
                        {
                          "include": "source.php#interpolation_double_quoted"
                        }
                      ]
                    },
                    {
                      "begin": "'",
                      "end": "'|(?=\")",
                      "name": "string.quoted.single.html",
                      "patterns": [
                        {
                          "include": "source.php#interpolation_double_quoted"
                        }
                      ]
                    },
                    {
                      "match": "[^\\s/>\"]+",
                      "name": "string.unquoted.html",
                      "patterns": [
                        {
                          "include": "source.php#interpolation_double_quoted"
                        }
                      ]
                    }
                  ]
                },
                {
                  "match": "\\s*([a-zA-Z0-9:-]+)(?=[\\s/>]|\")",
                  "captures": {
                    "1": {
                      "name": "entity.other.attribute-name.html"
                    }
                  }
                },
                {
                  "include": "source.php#interpolation_double_quoted"
                }
              ]
            },
            {
              "include": "source.php#interpolation_double_quoted"
            },
            {
              "include": "text.html.basic"
            }
          ]
        }
      ]
    },
    "html-string-single-quoted": {
      "begin": "(/\\*\\s?html\\s?\\*/)\\s*(')",
      "beginCaptures": {
        "1": {
          "name": "comment.block.php"
        },
        "2": {
          "name": "punctuation.definition.string.begin.php"
        }
      },
      "end": "(')",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.php"
        }
      },
      "name": "string.quoted.single.php",
      "patterns": [
        {
          "begin": "(?<=')",
          "contentName": "text.html.embedded.php",
          "end": "(?=')",
          "name": "string.quoted.single.html.php",
          "patterns": [
            {
              "match": "\\\\[\\\\']",
              "name": "constant.character.escape.php"
            },
            {
              "begin": "(<)([a-zA-Z][a-zA-Z0-9]*)",
              "end": "(?=(>|\\/>)|(?='))",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.tag.begin.html"
                },
                "2": {
                  "name": "entity.name.tag.html"
                }
              },
              "endCaptures": {
                "1": {
                  "name": "punctuation.definition.tag.end.html"
                }
              },
              "patterns": [
                {
                  "begin": "\\s*([a-zA-Z0-9:-]+)\\s*(=)\\s*",
                  "beginCaptures": {
                    "1": {
                      "name": "entity.other.attribute-name.html"
                    },
                    "2": {
                      "name": "punctuation.separator.key-value.html"
                    }
                  },
                  "end": "(?<=\")|(?<=')|(?=[\\s/>]|')",
                  "patterns": [
                    {
                      "begin": "\"",
                      "end": "\"|(?=')",
                      "name": "string.quoted.double.html",
                      "patterns": [
                        {
                          "match": "\\\\[\\\\']",
                          "name": "constant.character.escape.php"
                        }
                      ]
                    },
                    {
                      "begin": "'",
                      "end": "'|(?=')",
                      "name": "string.quoted.single.html",
                      "patterns": [
                        {
                          "match": "\\\\[\\\\']",
                          "name": "constant.character.escape.php"
                        }
                      ]
                    },
                    {
                      "match": "[^\\s/>']+",
                      "name": "string.unquoted.html"
                    }
                  ]
                },
                {
                  "match": "\\s*([a-zA-Z0-9:-]+)(?=[\\s/>]|')",
                  "captures": {
                    "1": {
                      "name": "entity.other.attribute-name.html"
                    }
                  }
                },
                {
                  "match": "\\\\[\\\\']",
                  "name": "constant.character.escape.php"
                }
              ]
            },
            {
              "include": "text.html.basic"
            }
          ]
        }
      ]
    }
  }
}
